{\pard\f1\fs32\b TAI LIEU MAU - FORMAT DOC (Word 97-2003)\b0\par}
{\pard\par}
{\pard\f1\fs22 Day la file dinh dang .doc co (Word 97-2003 / RTF).\par}
{\pard\f1\fs22 Dinh dang nay khong duoc ho tro xem truc tiep tren trinh duyet.\par}
{\pard\f1\fs22 Vui long tai ve va mo bang Microsoft Word hoac LibreOffice Writer.\par}
{\pard\par}
{\pard\f1\fs26\b Ly do khong ho tro preview:\b0\par}
{\pard\f1\fs22 - Dinh dang .doc (Word 97-2003) la dinh dang nhi phan phuc tap.\par}
{\pard\f1\fs22 - Trinh duyet khong co built-in support de doc dinh dang nay.\par}
{\pard\f1\fs22 - Khuyen nghi: chuyen doi sang .docx de xem truc tiep.\par}
{\pard\par}
{\pard\f1\fs26\b Dinh dang duoc ho tro xem truc tiep:\b0\par}
{\pard\f1\fs22 - PDF, XLSX, CSV, DOCX\par}
